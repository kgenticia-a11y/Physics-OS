# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Project Settings → API → service_role key (NEVER expose to client)
# Required for: account deletion (/api/account/delete)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── AI ────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ── App ───────────────────────────────────────────────────────────────────────
# Production URL — used for OAuth redirect allowlist in Supabase Auth settings
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel deployment checklist ───────────────────────────────────────────────
# 1. Set all vars above in Vercel → Settings → Environment Variables
#    for BOTH Production AND Preview environments.
# 2. In Supabase → Authentication → URL Configuration:
#    - Site URL: https://your-domain.vercel.app
#    - Redirect URLs: https://your-domain.vercel.app/auth/callback
#                     https://*-your-team.vercel.app/auth/callback  (for previews)
# 3. In Supabase → Authentication → Providers → Google:
#    - Add authorized redirect URI: https://your-project.supabase.co/auth/v1/callback
# 4. Run supabase/migrations/001_initial_schema.sql against your Supabase project
#    (SQL Editor → paste and run)
